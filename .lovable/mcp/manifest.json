{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://elzqxtrncamxiymbjqio.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "mattebo-builder",
      "version": "0.1.0",
      "title": "Mattebo Builder"
    },
    "tools": [
      {
        "name": "list_chapter_sections",
        "title": "Lista kapitel och delkapitel",
        "description": "List the chapters and sub-chapters for a grade, including which sub-chapter is currently highlighted.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "grade": {
              "type": "integer",
              "minimum": 6,
              "maximum": 9,
              "description": "Årskurs (6–9)."
            }
          },
          "required": [
            "grade"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_homework",
        "title": "Visa läxa",
        "description": "Show the current homework posted for a grade.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "grade": {
              "type": "integer",
              "minimum": 6,
              "maximum": 9,
              "description": "Årskurs (6–9)."
            }
          },
          "required": [
            "grade"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_lesson_plans",
        "title": "Lista lektionsplaneringar",
        "description": "List upcoming lesson plans for a grade, starting from a date (default today).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "grade": {
              "type": "integer",
              "minimum": 6,
              "maximum": 9,
              "description": "Årskurs (6–9)."
            },
            "from": {
              "description": "Start date YYYY-MM-DD (default today).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "limit": {
              "description": "Max number of lessons (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "grade"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_lunch_menu",
        "title": "Visa matsedel",
        "description": "Show the school lunch menu for the coming days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "days": {
              "description": "How many days ahead (default 5).",
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "self_assessment_summary",
        "title": "Sammanfatta självskattning",
        "description": "Summarize self-assessment answers per question for one sub-chapter. Teachers see the class; students see only their own answers.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "grade": {
              "type": "integer",
              "minimum": 6,
              "maximum": 9,
              "description": "Årskurs (6–9)."
            },
            "chapter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Kapitel (1–5)."
            },
            "sectionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Sub-chapter index (0 = first), see list_chapter_sections."
            }
          },
          "required": [
            "grade",
            "chapter",
            "sectionIndex"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
